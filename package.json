{
  "name": "silicon-empire",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "pnpm desktop:compile && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "build": "pnpm typecheck && vite build",
    "desktop:compile": "tsc -p apps/desktop/tsconfig.json",
    "desktop": "pnpm build && pnpm desktop:compile && electron .",
    "desktop:dist": "pnpm build && pnpm desktop:compile && electron-builder --publish never",
    "test:desktop": "playwright test -c playwright.desktop.config.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@silicon-empire/game-data": "workspace:*",
    "@silicon-empire/simulation": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "3.2.7",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "description": "Jeu de gestion et d’automatisation de l’industrie informatique.",
  "homepage": "https://github.com/1002-AZ-2001/Silicon-Empire",
  "author": {
    "name": "Silicon Empire"
  },
  "main": "build/desktop/main.cjs",
  "desktopName": "silicon-empire.desktop"
}
